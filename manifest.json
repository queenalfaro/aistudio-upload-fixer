{
  "manifest_version": 3,
  "name": "AI Studio Upload Fixer",
  "version": "4.0",
  "description": "Нативный 100% перехват в памяти рантайма JavaScript без использования DOM-наблюдателей, кликов по кнопкам и двойных сетевых загрузок.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aistudio-upload-fixer@local.test"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["page-world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
