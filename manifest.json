{
  "manifest_version": 3,
  "name": "AI Studio Upload Fixer",
  "version": "1.1",
  "description": "Автоматически переименовывает заблокированные файлы (.py, .js, Dockerfile и др.) в .txt перед загрузкой в AI Studio.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aistudio-upload-fixer@local.test"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["page-world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}